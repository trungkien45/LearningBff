@section Scripts {
    <!-- Select2 JS -->
    <script src="~/libs/select2/js/select2.full.min.js"></script>

    <script>
        var currentSubjectId = @(Model.CurrentSubject?.Id ?? 0);
        var activeExamId = 0;
        var availableQuestionsPage = 1;
        var availableQuestionsPageSize = 10;
        var activeExamMaxScore = 0;
        var availableQuestionsSearchTimer;
        var examResultsPage = 1;
        var examResultsPageSize = 10;
        var examResultsSearchTimer;

        $(document).ready(function () {
            // Khởi tạo Select2 AJAX phân trang
            $('#subjectSelect').select2({
                placeholder: '--- Gõ tên hoặc chọn môn học ---',
                allowClear: true,
                language: {
                    noResults: function () { return "Không tìm thấy môn học nào"; },
                    searching: function () { return "Đang tìm kiếm môn học..."; },
                    loadingMore: function () { return "Đang tải thêm môn học..."; }
                },
                ajax: {
                    url: '?handler=SubjectsJson',
                    dataType: 'json',
                    delay: 300,
                    data: function (params) {
                        return {
                            name: params.term || '',
                            page: params.page || 1,
                            pageSize: 10
                        };
                    },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return {
                            results: data.items,
                            pagination: {
                                more: (params.page * 10) < data.totalCount
                            }
                        };
                    },
                    cache: true
                }
            });

            // Khi chọn môn học -> redirect
            $('#subjectSelect').on('change', function () {
                var selectedId = $(this).val();
                if (selectedId) {
                    window.location.href = '?subjectId=' + selectedId;
                } else {
                    window.location.href = '@Url.Page("/Teacher/Exams")';
                }
            });

            $('#availableQuestionsSearch').on('input', function () {
                clearTimeout(availableQuestionsSearchTimer);
                availableQuestionsSearchTimer = setTimeout(function () {
                    availableQuestionsPage = 1;
                    loadExamQuestions(currentSubjectId, activeExamId, availableQuestionsPage);
                }, 300);
            });

            $('#examResultsSearch').on('input', function () {
                clearTimeout(examResultsSearchTimer);
                examResultsSearchTimer = setTimeout(function () {
                    loadExamResults(currentSubjectId, activeExamId, 1);
                }, 300);
            });

            // Tải thông tin chi tiết từng đề thi (thời lượng, trạng thái xuất bản)
            $('.exam-pub-badge').each(function () {
                var badge = $(this);
                var examId = badge.data('exam-id');
                var row = badge.closest('tr');
                var subjectId = badge.data('subject-id');
                if (subjectId && examId) {
                    $.getJSON('?handler=ExamDetailsJson', { subjectId: subjectId, examId: examId }, function (res) {
                        if (res && res.success && res.data) {
                            var d = res.data;
                            row.find('[data-exam-duration]').html('<span class="badge bg-light text-dark border"><i class="fas fa-clock me-1 text-primary"></i> ' + d.durationInMinutes + ' phút</span>');
                            if (d.isPublished) {
                                badge.removeClass('bg-light text-secondary').addClass('badge-pub badge-pub-yes').html('<i class="fas fa-check-circle me-1"></i> Đã xuất bản');
                            } else {
                                badge.removeClass('bg-light text-secondary').addClass('badge-pub badge-pub-no').html('<i class="fas fa-pencil-ruler me-1"></i> Bản nháp');
                            }
                        }
                    });
                }
            });
        });

        function openModal(id) {
            var el = document.getElementById(id);
            if (el) {
                el.classList.add('active');
                document.body.style.overflow = 'hidden';
            }
        }

        function closeModal(id) {
            var el = document.getElementById(id);
            if (el) {
                el.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        function openCreateExamModal() {
            openModal('createExamModal');
        }

        function openEditExamModal(subjectId, examId) {
            currentSubjectId = subjectId;
            $.getJSON('?handler=ExamDetailsJson', { subjectId: subjectId, examId: examId }, function (res) {
                if (res && res.success && res.data) {
                    var d = res.data;
                    document.getElementById('editExamSubjectId').value = subjectId;
                    document.getElementById('editExamId').value = d.id;
                    document.getElementById('editExamTitle').value = d.title;
                    document.getElementById('editExamDescription').value = d.description || '';
                    document.getElementById('editExamDuration').value = d.durationInMinutes;
                    document.getElementById('editExamMaxScore').value = d.maxScore;
                    document.getElementById('editExamPassScore').value = d.passScore;
                    document.getElementById('editShuffleQ').checked = d.shuffleQuestions;
                    document.getElementById('editShuffleA').checked = d.shuffleAnswers;
                    document.getElementById('editMaxAttempts').value = d.maxAttempts || '';
                    openModal('editExamModal');
                }
            });
        }

        function unpublishExam(subjectId, examId, attemptsUsed) {
            if (attemptsUsed > 0) {
                if (!confirm(
                    'Đã có ' + attemptsUsed + ' lượt làm bài. Khi gỡ xuất bản, toàn bộ lượt làm và kết quả sẽ bị xóa. Bạn có muốn tiếp tục không?'
                )) {
                    return;
                }
            } else if (!confirm('Bạn có chắc chắn muốn gỡ xuất bản đề thi này không?')) {
                return;
            }

            document.getElementById('unpublishSubjectId').value = subjectId;
            document.getElementById('unpublishExamId').value = examId;
            document.getElementById('unpublishExamForm').submit();
        }

        function openDeleteExamModal(subjectId, id, title) {
            currentSubjectId = subjectId;
            document.getElementById('deleteExamSubjectId').value = subjectId;
            document.getElementById('deleteExamId').value = id;
            document.getElementById('deleteExamTitle').textContent = title;
            openModal('deleteExamModal');
        }

        // Quản lý câu hỏi trong đề
        function openExamQuestionsModal(subjectId, examId, title) {
            currentSubjectId = subjectId;
            activeExamId = examId;
            availableQuestionsPage = 1;
            $('#availableQuestionsSearch').val('');
            $('#examQuestionScoreWarning').addClass('d-none').empty();
            document.getElementById('examQuestionsModalTitle').textContent = title;
            loadExamQuestions(subjectId, examId, availableQuestionsPage);
            openModal('examQuestionsModal');
        }

        function loadExamQuestions(subjectId, examId, page) {
            page = Math.max(1, page || 1);
            var inContainer = $('#inExamQuestionsContainer');
            var avContainer = $('#availableQuestionsContainer');
            inContainer.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>');
            avContainer.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>');
            $('#availableQuestionsPager').empty();

            $.getJSON('?handler=ExamQuestionsJson', {
                subjectId: subjectId,
                examId: examId,
                page: page,
                pageSize: availableQuestionsPageSize,
                search: $('#availableQuestionsSearch').val().trim()
            }, function (res) {
                if (res && res.success) {
                    $('#inExamCount').text(res.examQuestions.length);
                    $('#availableCount').text(res.totalCount);
                    activeExamMaxScore = res.maxScore;
                    var totalPages = Math.max(1, Math.ceil(res.totalCount / res.pageSize));
                    if (res.currentPage > totalPages) {
                        loadExamQuestions(subjectId, examId, totalPages);
                        return;
                    }
                    availableQuestionsPage = res.currentPage;

                    // Render questions in exam
                    if (res.examQuestions.length === 0) {
                        inContainer.html('<div class="alert alert-info small mb-0"><i class="fas fa-info-circle me-1"></i> Chưa có câu hỏi nào trong đề thi này. Hãy chuyển sang tab "Thêm từ ngân hàng" để chọn câu hỏi.</div>');
                    } else {
                        var html = '<div class="list-group">';
                        res.examQuestions.forEach(function (q, idx) {
                            html += '<div class="list-group-item d-flex align-items-center justify-content-between gap-3 p-2">';
                            html += '  <div class="flex-grow-1"><span class="badge bg-secondary me-2">' + (idx + 1) + '</span><span class="fw-semibold">' + q.title + '</span></div>';
                            html += '  <div class="d-flex align-items-center gap-2 flex-shrink-0">';
                            html += '    <label class="small mb-0" for="examQuestionScore' + q.id + '">Điểm</label>';
                            html += '    <input type="number" id="examQuestionScore' + q.id + '" class="form-control form-control-sm" style="width: 90px" min="0" step="0.25" value="' + q.defaultScore + '" aria-label="Điểm câu hỏi" />';
                            html += '    <button type="button" class="btn btn-sm btn-outline-primary" onclick="updateQuestionScore(' + q.id + ')">Lưu điểm</button>';
                            html += '    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestionFromExam(' + q.id + ')"><i class="fas fa-trash-alt me-1"></i> Gỡ</button>';
                            html += '  </div>';
                            html += '</div>';
                        });
                        html += '</div>';
                        inContainer.html(html);
                    }

                    // Render available questions
                    if (res.availableQuestions.length === 0) {
                        var emptyMessage = $('#availableQuestionsSearch').val().trim()
                            ? 'Không tìm thấy câu hỏi phù hợp với từ khóa.'
                            : 'Đã thêm tất cả câu hỏi của môn học này vào đề thi!';
                        avContainer.empty().append(
                            $('<div class="alert alert-info small mb-0"></div>').text(emptyMessage)
                        );
                    } else {
                        var htmlAv = '<div class="list-group">';
                        res.availableQuestions.forEach(function (q) {
                            htmlAv += '<div class="list-group-item d-flex align-items-center justify-content-between gap-3 p-2">';
                            htmlAv += '  <div class="flex-grow-1"><span class="fw-semibold">' + q.title + '</span><div class="text-muted small">Điểm mặc định: ' + q.defaultScore + '</div></div>';
                            htmlAv += '  <div class="d-flex align-items-center gap-2 flex-shrink-0">';
                            htmlAv += '    <label class="small mb-0" for="questionScore' + q.id + '">Điểm</label>';
                            var scoreValue = res.examQuestions.length === 0 ? activeExamMaxScore : q.defaultScore;
                            htmlAv += '    <input type="number" id="questionScore' + q.id + '" class="form-control form-control-sm" style="width: 90px" min="0" step="0.25" value="' + scoreValue + '" aria-label="Điểm câu hỏi" />';
                            htmlAv += '    <button type="button" class="btn btn-sm btn-outline-success" onclick="addQuestionToExam(' + q.id + ', document.getElementById(\'questionScore' + q.id + '\').value)"><i class="fas fa-plus me-1"></i> Thêm</button>';
                            htmlAv += '  </div>';
                            htmlAv += '</div>';
                        });
                        htmlAv += '</div>';
                        avContainer.html(htmlAv);
                    }

                    var firstItem = res.totalCount === 0 ? 0 : (res.currentPage - 1) * res.pageSize + 1;
                    var lastItem = Math.min(res.currentPage * res.pageSize, res.totalCount);
                    var pagerHtml = '<span class="text-muted small">Hiển thị ' + firstItem + ' - ' + lastItem + ' trên ' + res.totalCount + ' câu hỏi</span>';
                    if (totalPages > 1) {
                        pagerHtml += '<div class="btn-group btn-group-sm" role="group" aria-label="Phân trang câu hỏi">';
                        pagerHtml += '<button type="button" class="btn btn-outline-secondary" ' +
                            (res.currentPage <= 1 ? 'disabled' : 'onclick="loadExamQuestions(currentSubjectId, activeExamId, ' + (res.currentPage - 1) + ')"') +
                            '><i class="fas fa-chevron-left"></i> Trước</button>';
                        pagerHtml += '<span class="btn btn-outline-secondary disabled">Trang ' + res.currentPage + ' / ' + totalPages + '</span>';
                        pagerHtml += '<button type="button" class="btn btn-outline-secondary" ' +
                            (res.currentPage >= totalPages ? 'disabled' : 'onclick="loadExamQuestions(currentSubjectId, activeExamId, ' + (res.currentPage + 1) + ')"') +
                            '>Sau <i class="fas fa-chevron-right"></i></button>';
                        pagerHtml += '</div>';
                    }
                    $('#availableQuestionsPager').html(pagerHtml);
                } else {
                    var message = res && res.message ? res.message : 'Không thể tải danh sách câu hỏi.';
                    inContainer.empty().append($('<div class="alert alert-danger small mb-0"></div>').text(message));
                    avContainer.empty().append($('<div class="alert alert-danger small mb-0"></div>').text(message));
                }
            }).fail(function () {
                var message = 'Không thể tải danh sách câu hỏi. Vui lòng thử lại.';
                inContainer.empty().append($('<div class="alert alert-danger small mb-0"></div>').text(message));
                avContainer.empty().append($('<div class="alert alert-danger small mb-0"></div>').text(message));
                $('#availableQuestionsPager').empty();
            });
        }

        function addQuestionToExam(questionId, scoreValue) {
            var score = Number(scoreValue);
            if (!Number.isFinite(score) || score < 0) {
                alert('Điểm câu hỏi phải là số không âm hợp lệ.');
                return;
            }

            $.post('?handler=AddQuestion', {
                subjectId: currentSubjectId,
                examId: activeExamId,
                questionId: questionId,
                score: score
            }, function (res) {
                if (res && res.success) {
                    showExamQuestionScoreSummary(res.scoreSummary, 'Đã thêm câu hỏi.');
                    loadExamQuestions(currentSubjectId, activeExamId, availableQuestionsPage);
                } else {
                    alert(res.message || 'Không thể thêm câu hỏi.');
                }
            }).fail(function () {
                alert('Không thể thêm câu hỏi. Vui lòng thử lại.');
            });
        }

        function updateQuestionScore(questionId) {
            var score = Number(document.getElementById('examQuestionScore' + questionId).value);
            if (!Number.isFinite(score) || score < 0) {
                alert('Điểm câu hỏi phải là số không âm hợp lệ.');
                return;
            }

            $.post('?handler=UpdateQuestionScore', {
                subjectId: currentSubjectId,
                examId: activeExamId,
                questionId: questionId,
                score: score
            }, function (res) {
                if (res && res.success) {
                    showExamQuestionScoreSummary(res.scoreSummary, 'Đã cập nhật điểm câu hỏi.');
                    loadExamQuestions(currentSubjectId, activeExamId, availableQuestionsPage);
                } else {
                    alert(res.message || 'Không thể cập nhật điểm câu hỏi.');
                }
            }).fail(function () {
                alert('Không thể cập nhật điểm câu hỏi. Vui lòng thử lại.');
            });
        }

        function showExamQuestionScoreSummary(summary, successMessage) {
            var alertElement = $('#examQuestionScoreWarning');
            alertElement.removeClass('d-none alert-warning alert-success alert-danger');
            if (summary && summary.isValid) {
                alertElement.addClass('alert-success').text(
                    successMessage + ' Tổng điểm câu hỏi (' + summary.totalScore + ') bằng tổng điểm đề thi (' + summary.maxScore + ').'
                );
            } else if (summary) {
                alertElement.addClass('alert-warning').text(
                    successMessage + ' Tổng điểm hiện tại (' + summary.totalScore + ') chưa bằng tổng điểm đề thi (' + summary.maxScore + '). Hãy chỉnh điểm trước khi xuất bản.'
                );
            } else {
                alertElement.addClass('alert-danger').text(successMessage + ' Không lấy được trạng thái tổng điểm.');
            }
        }

        function removeQuestionFromExam(questionId) {
            if (!confirm('Bạn có chắc chắn muốn gỡ câu hỏi này khỏi đề thi?')) return;
            $.post('?handler=RemoveQuestion', { subjectId: currentSubjectId, examId: activeExamId, questionId: questionId }, function (res) {
                if (res && res.success) {
                    showExamQuestionScoreSummary(res.scoreSummary, 'Đã gỡ câu hỏi.');
                    loadExamQuestions(currentSubjectId, activeExamId, availableQuestionsPage);
                } else {
                    alert(res.message || 'Không thể gỡ câu hỏi.');
                }
            }).fail(function () {
                alert('Không thể gỡ câu hỏi. Vui lòng thử lại.');
            });
        }

        // Kết quả thi
                var gradingResultId = 0;
        var gradingExamId = 0;
        var currentGradingQuestions = [];

        function openExamResultsModal(subjectId, examId, title) {
            currentSubjectId = subjectId;
            activeExamId = examId;
            document.getElementById('examResultsModalTitle').textContent = title;
            $('#examResultsSearch').val('');
            openModal('examResultsModal');
            loadExamResults(subjectId, examId, 1);
        }

        function loadExamResults(subjectId, examId, page) {
            page = page || 1;
            var container = $('#examResultsContainer');
            var pager = $('#examResultsPager');
            container.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải danh sách kết quả...</div>');
            pager.empty();

            var searchVal = $('#examResultsSearch').val() ? $('#examResultsSearch').val().trim() : '';

            $.getJSON('?handler=ExamResultsJson', {
                subjectId: subjectId,
                examId: examId,
                page: page,
                pageSize: examResultsPageSize,
                search: searchVal
            }, function (res) {
                if (res && res.success) {
                    var items = res.data;
                    var totalCount = res.totalCount || 0;
                    var totalPages = Math.max(1, Math.ceil(totalCount / res.pageSize));

                    if (res.currentPage > totalPages && totalPages > 0) {
                        loadExamResults(subjectId, examId, totalPages);
                        return;
                    }
                    examResultsPage = res.currentPage;

                    if (!items || items.length === 0) {
                        if (searchVal) {
                            container.html('<div class="alert alert-warning small mb-0"><i class="fas fa-exclamation-triangle me-1"></i> Không tìm thấy học viên nào phù hợp với từ khóa "' + $('<div>').text(searchVal).html() + '".</div>');
                        } else {
                            container.html('<div class="alert alert-info small mb-0"><i class="fas fa-info-circle me-1"></i> Chưa có học viên nào nộp bài thi cho đề này.</div>');
                        }
                        pager.empty();
                        return;
                    }

                    var html = '<table class="custom-table table-sm">';
                    html += '<thead><tr><th>Học viên</th><th class="text-center">Trạng thái chấm</th><th class="text-center">Điểm số</th><th>Thời gian nộp</th><th class="text-end">Hành động</th></tr></thead><tbody>';
                    items.forEach(function (r) {
                        var dateStr = r.submitTime ? new Date(r.submitTime).toLocaleString() : '-';
                        var isPending = r.gradingStatus === 1; // Pending
                        var statusBadge = '';
                        if (isPending) {
                            statusBadge = '<span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i> Chưa chấm</span>';
                        } else {
                            statusBadge = '<span class="badge bg-success"><i class="fas fa-check-circle me-1"></i> Đã chấm</span>';
                        }

                        html += '<tr>';
                        html += '  <td><strong>' + (r.userFullName || r.userName) + '</strong><br><small class="text-muted">' + r.userName + '</small></td>';
                        html += '  <td class="text-center">' + statusBadge + '</td>';
                        html += '  <td class="text-center fw-bold text-primary">' + (isPending ? '<span class="text-muted">--</span>' : r.score.toFixed(1)) + '</td>';
                        html += '  <td class="small text-muted">' + dateStr + '</td>';
                        html += '  <td class="text-end">';
                        html += '    <button type="button" class="btn btn-sm btn-primary fw-semibold me-1" onclick="openGradeModal(' + subjectId + ', ' + examId + ', ' + r.id + ', \'' + (r.userFullName || r.userName) + '\')"><i class="fas fa-marker me-1"></i> ' + (isPending ? 'Chấm bài' : 'Xem / Sửa chấm') + '</button>';
                        html += '    <a href="/Exam/Result?resultId=' + r.id + '" target="_blank" class="btn btn-sm btn-light border" title="Xem dạng học viên"><i class="fas fa-external-link-alt text-secondary"></i></a>';
                        html += '  </td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    container.html(html);

                    var firstItem = totalCount === 0 ? 0 : (res.currentPage - 1) * res.pageSize + 1;
                    var lastItem = Math.min(res.currentPage * res.pageSize, totalCount);
                    var pagerHtml = '<span class="text-muted small">Hiển thị ' + firstItem + ' - ' + lastItem + ' trên ' + totalCount + ' kết quả</span>';
                    if (totalPages > 1) {
                        pagerHtml += '<div class="btn-group btn-group-sm" role="group" aria-label="Phân trang kết quả thi">';
                        pagerHtml += '<button type="button" class="btn btn-outline-secondary" ' +
                            (res.currentPage <= 1 ? 'disabled' : 'onclick="loadExamResults(currentSubjectId, activeExamId, ' + (res.currentPage - 1) + ')"') +
                            '><i class="fas fa-chevron-left"></i> Trước</button>';
                        pagerHtml += '<span class="btn btn-outline-secondary disabled">Trang ' + res.currentPage + ' / ' + totalPages + '</span>';
                        pagerHtml += '<button type="button" class="btn btn-outline-secondary" ' +
                            (res.currentPage >= totalPages ? 'disabled' : 'onclick="loadExamResults(currentSubjectId, activeExamId, ' + (res.currentPage + 1) + ')"') +
                            '>Sau <i class="fas fa-chevron-right"></i></button>';
                        pagerHtml += '</div>';
                    }
                    pager.html(pagerHtml);
                } else {
                    var message = res && res.message ? res.message : 'Không thể tải danh sách kết quả.';
                    container.html('<div class="alert alert-danger small mb-0">' + message + '</div>');
                    pager.empty();
                }
            }).fail(function () {
                container.html('<div class="alert alert-danger small mb-0">Không thể tải danh sách kết quả. Vui lòng thử lại.</div>');
                pager.empty();
            });
        }

        function openGradeModal(subjectId, examId, resultId, studentName) {
            gradingResultId = resultId;
            gradingExamId = examId;
            currentSubjectId = subjectId;

            document.getElementById('gradeExamModalSubtitle').textContent = 'Học viên: ' + studentName + ' • Lượt làm bài #' + resultId;
            var container = $('#gradeQuestionsContainer');
            container.html('<div class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin"></i> Đang tải bài làm...</div>');
            $('#overallGradeFeedback').val('');
            openModal('gradeExamModal');

            $.getJSON('?handler=ExamResultForGradingJson', { subjectId: subjectId, examId: examId, resultId: resultId }, function (res) {
                if (res && res.success && res.data) {
                    var d = res.data;
                    currentGradingQuestions = d.questions || [];
                    $('#overallGradeFeedback').val(d.overallFeedback || '');

                    if (currentGradingQuestions.length === 0) {
                        container.html('<div class="alert alert-info">Đề thi không có câu hỏi nào.</div>');
                        return;
                    }

                    var html = '';
                    currentGradingQuestions.forEach(function (q, idx) {
                        var qNum = idx + 1;
                        var isText = q.questionType === 3;
                        var isMixed = q.questionType === 4;
                        var isMulti = q.questionType === 2;
                        var isSingle = q.questionType === 1;

                        html += '<div class="card p-3 mb-3 border">';
                        html += '  <div class="d-flex justify-content-between align-items-center mb-2">';
                        html += '    <span class="badge bg-dark">Câu ' + qNum + '</span>';
                        html += '    <div class="d-flex align-items-center gap-2">';
                        html += '      <span class="badge bg-light text-secondary border">';
                        if (isText) html += 'Tự luận';
                        else if (isMixed) html += 'Bán trắc nghiệm';
                        else if (isMulti) html += 'Trắc nghiệm nhiều đáp án';
                        else html += 'Trắc nghiệm 1 đáp án';
                        html += '      </span>';
                        html += '      <span class="small fw-bold text-muted">Điểm tối đa: ' + q.maxScore + '</span>';
                        html += '    </div>';
                        html += '  </div>';

                        html += '  <h6 class="fw-bold mb-2 text-dark">' + q.questionTitle + '</h6>';

                        // Options if any
                        if (q.options && q.options.length > 0) {
                            html += '  <div class="bg-light p-2 rounded mb-2 small">';
                            html += '    <strong>Phương án trắc nghiệm:</strong>';
                            q.options.forEach(function (opt) {
                                var prefix = opt.isSelectedByStudent ? '<i class="fas fa-check-circle text-primary"></i> [Học viên chọn] ' : '';
                                var correctTag = opt.isCorrectAnswer ? ' <span class="badge bg-success ms-1">Đúng</span>' : '';
                                html += '    <div class="py-1 ' + (opt.isSelectedByStudent ? 'fw-bold text-primary' : '') + '">' + prefix + opt.text + correctTag + '</div>';
                            });
                            html += '  </div>';
                        }

                        // Student text answer
                        if (q.studentAnswerText) {
                            html += '  <div class="alert alert-secondary p-2 mb-2 small">';
                            html += '    <div class="fw-bold text-dark mb-1"><i class="fas fa-pen-nib me-1"></i> Bài làm văn bản của học viên:</div>';
                            html += '    <div style="white-space: pre-wrap;">' + q.studentAnswerText + '</div>';
                            html += '  </div>';
                        } else if (isText || isMixed) {
                            html += '  <div class="alert alert-light border p-2 mb-2 small text-muted"><em>Học viên không điền nội dung văn bản cho câu này.</em></div>';
                        }

                        // Grading Guide if any
                        if (q.gradingGuide) {
                            html += '  <div class="p-2 bg-info bg-opacity-10 border border-info border-opacity-25 rounded mb-2 small text-info-emphasis">';
                            html += '    <strong><i class="fas fa-info-circle me-1"></i> Hướng dẫn chấm / Gợi ý đáp án:</strong> ' + q.gradingGuide;
                            html += '  </div>';
                        }

                        // Score input & feedback
                        html += '  <div class="row g-2 align-items-center mt-1 pt-2 border-top">';
                        html += '    <div class="col-md-4 d-flex align-items-center gap-2">';
                        html += '      <label class="form-label small fw-bold mb-0 text-nowrap">Điểm cho câu:</label>';
                        html += '      <input type="number" step="0.25" min="0" max="' + q.maxScore + '" class="form-control form-control-sm text-center fw-bold" id="grade_score_' + q.questionId + '" value="' + (q.earnedScore || 0) + '" />';
                        html += '      <span class="small text-muted">/ ' + q.maxScore + '</span>';
                        html += '    </div>';
                        html += '    <div class="col-md-8">';
                        html += '      <input type="text" class="form-control form-control-sm" id="grade_fb_' + q.questionId + '" placeholder="Nhận xét của giáo viên cho câu này..." value="' + (q.teacherFeedback || '') + '" />';
                        html += '    </div>';
                        html += '  </div>';

                        html += '</div>';
                    });

                    container.html(html);
                } else {
                    container.html('<div class="alert alert-danger">Không thể tải chi tiết bài làm.</div>');
                }
            });
        }

        function submitGrading() {
            var btn = $('#btnSaveGrade');
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...');

            var payload = {
                resultId: gradingResultId,
                overallFeedback: $('#overallGradeFeedback').val().trim(),
                questionGrades: []
            };

            currentGradingQuestions.forEach(function (q) {
                var score = parseFloat($('#grade_score_' + q.questionId).val()) || 0;
                var fb = $('#grade_fb_' + q.questionId).val() || '';
                payload.questionGrades.push({
                    questionId: q.questionId,
                    earnedScore: score,
                    teacherFeedback: fb
                });
            });

            $.ajax({
                url: '?handler=GradeResultJson&subjectId=' + currentSubjectId + '&examId=' + gradingExamId,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> Hoàn tất chấm & Lưu điểm');
                    if (res && res.success) {
                        alert('Đã lưu kết quả chấm thi thành công!');
                        closeModal('gradeExamModal');
                        loadExamResults(currentSubjectId, gradingExamId, examResultsPage);
                    } else {
                        alert(res.message || 'Lỗi khi lưu kết quả chấm.');
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html('<i class="fas fa-check-circle me-1"></i> Hoàn tất chấm & Lưu điểm');
                    alert('Lỗi kết nối khi lưu kết quả chấm.');
                }
            });
        }
      </script>
}